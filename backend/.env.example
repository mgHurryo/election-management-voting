# =============================================================================
# Election Management & Voting - environment template
# =============================================================================
# Copy this file to `.env` (same directory: backend/.env) and fill in real
# values. The real `.env` is gitignored and must never be committed.
#
# Variable names follow ARCHITECTURE_CN.md sections 4.11 and 13.5.
# The database bootstrap section below is consumed by
# backend/database/init/env_config.py, which is shared by both
# 00_init_database.py (CREATE DATABASE / CREATE USER / GRANT) and
# 01_init_schema.py (create baseline tables).
#
# The application section is consumed by app/core/config.py. Runtime ignores
# the administrator fields and refuses root, blank secrets and placeholders.

# --- MySQL server location (shared by admin bootstrap and runtime) ---
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Administrator / migration account (creates database and app account) ---
# Never used by the FastAPI runtime. Do NOT reuse the app credentials here.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=change-me

# --- Target application database ---
DB_NAME=election_voting
# Bootstrap extras; optional, defaults shown. Charset is fixed to utf8mb4 by
# the architecture document.
DB_CHARSET=utf8mb4
# MySQL account host pattern for the app user, e.g. % (any host) or localhost
DB_USER_HOST=localhost

# --- Application database account (least privilege: SELECT/INSERT/UPDATE/DELETE) ---
DB_USER=election_app
DB_PASSWORD=change-me

# --- Authentication (consumed by the FastAPI app core, not the init scripts) ---
# Generate a random secret of at least 32 bytes; never reuse a demo value.
JWT_SECRET=replace-me-with-a-random-secret-at-least-32-bytes
# ADR-009 default: 60 minutes, no refresh token.
JWT_EXPIRE_MINUTES=60

# --- Frontend / backend communication ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Runtime ---
# APP_ENV: development | test | production
APP_ENV=development
LOG_LEVEL=INFO
